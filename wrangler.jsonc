{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mi-coche",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",

  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mi-coche-db",
      "database_id": "REEMPLAZAR_CON_DATABASE_ID"
    }
  ],

  "secrets": {
    "required": ["TOKEN_ADRI", "TOKEN_LAURA"]
  }
}
